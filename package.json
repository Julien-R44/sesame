{
  "name": "@julr/sesame",
  "description": "OAuth 2.1 + OIDC server for AdonisJS",
  "version": "0.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./exceptions": "./build/src/oauth_error.js",
    "./types": "./build/src/types.js",
    "./storage/types": "./build/src/storage/types.js",
    "./drivers/lucid": "./build/src/storage/drivers/lucid.js",
    "./drivers/kysely": "./build/src/storage/drivers/kysely.js",
    "./sesame_provider": "./build/providers/sesame_provider.js",
    "./guard": "./build/src/guard/main.js",
    "./guard/lucid": "./build/src/guard/lucid.js",
    "./scope_middleware": "./build/src/middleware/scope_middleware.js",
    "./any_scope_middleware": "./build/src/middleware/any_scope_middleware.js",
    "./client_id_metadata_documents/fetcher": "./build/src/client_id_metadata_documents/fetcher.js",
    "./services/main": "./build/services/main.js",
    "./commands/*": "./build/commands/*.js",
    "./commands": "./build/commands/main.js"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test:sql": "bash bin/test_sql_dialects.sh",
    "test": "c8 npm run quick:test",
    "build": "tsdown && tsc --emitDeclarationOnly --declaration && adonis-kit index build/commands",
    "docs:dev": "pnpm --filter @julr/sesame-website dev",
    "docs:build": "pnpm --filter @julr/sesame-website build",
    "docs:preview": "pnpm --filter @julr/sesame-website preview",
    "release": "release-it",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julien-R44/sesame.git"
  },
  "bugs": {
    "url": "https://github.com/Julien-R44/sesame/issues"
  },
  "homepage": "https://github.com/Julien-R44/sesame#readme",
  "keywords": [
    "adonisjs",
    "adonis",
    "oauth",
    "oauth2.1",
    "oidc",
    "openid-connect",
    "authorization-server",
    "mcp",
    "pkce"
  ],
  "author": "Julien Ripouteau",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@julr/tooling-configs": "^6.1.2",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "kysely": "^0.29.6",
    "lint-staged": "^17.6.0",
    "mysql2": "^3.24.4",
    "node-gyp": "^13.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pg": "^8.23.0",
    "release-it": "^21.1.0",
    "taze": "^21.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,markdown,yml,yaml,css,scss,html}": "oxfmt --write"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^21.0.0 || ^22.0.0",
    "@vinejs/vine": "^4.0.0",
    "kysely": "^0.29.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "dependencies": {
    "jose": "^6.2.12",
    "luxon": "^3.7.2"
  }
}
