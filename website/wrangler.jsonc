{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sesame-docs",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "sesame.julr.dev", "custom_domain": true }],
}
