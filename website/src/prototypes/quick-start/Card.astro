---
/**
 * Prototype "Card": the quick start continues the capability cards. One wide
 * card, same surface and radius, the door drawn in ASCII on the left and the
 * setup on the right. Dark in both themes, like the cards.
 */
import CopyButton from '../../components/CopyButton.astro'
import Ascii from '../../components/Ascii.astro'
import heroImage from '../../assets/hero-duo-arches.jpg'
import { title, lead, guide, commands, routes, routesHtml } from './data'
---

<section>
  <header class="head">
    <h2>{title}</h2>
    <p class="lead">{lead}</p>
  </header>

  <div class="card">
    <div class="art" aria-hidden="true">
      <Ascii src={heroImage} size={8} mobileSize={7} focus={0.86} place={0.55} zoom={1.4} />
    </div>

    <div class="body">
      <div class="cmds">
        {
          commands.map((c) => (
            <div class="cmd">
              <span class="p" aria-hidden="true">$</span>
              <code>{c.command}</code>
              <CopyButton text={c.command} label={`Copy ${c.command}`} />
              <span class="note">{c.note}</span>
            </div>
          ))
        }
      </div>

      <div class="file">
        <div class="file-head">
          <span>start/routes.ts</span>
          <CopyButton text={routes} label="Copy start/routes.ts" />
        </div>
        <pre class="code"><code set:html={routesHtml} /></pre>
      </div>

      <a class="link" href={guide}>Read the setup guide <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 38rem;
    margin-bottom: 3.5rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .lead {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  /* Same card as the capabilities: border, radius, near-black surface. */
  .card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border: 1px solid var(--sesame-border);
    border-radius: 0.75rem;
    background: #0a0a0a;
    overflow: hidden;
    color: #f2f0ec;
  }

  .art {
    position: relative;
    min-height: 22rem;
    background: #050505;
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }

  .art :global(sesame-ascii) {
    inset: 2rem 2.5rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 2rem 1.25rem 2rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .cmds {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .cmd {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    align-items: center;
  }

  .p {
    color: #ffaa3b;
    user-select: none;
  }

  .cmd code,
  .code code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .cmd code {
    color: #f2f0ec;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .note {
    grid-column: 2 / -1;
    margin-top: -0.25rem;
    font-size: 0.75rem;
    color: #6e6a65;
  }

  .file {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .file-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: -0.375rem;
    font-size: 0.75rem;
    color: #6e6a65;
  }

  .code {
    margin: 0.25rem 0 0;
    padding: 0;
    overflow-x: auto;
    border: 0;
    background: none;
    color: #d6d3ce;
  }

  /* Vesper, like the code blocks in the docs. */
  .code :global(.k) {
    color: #a0a0a0;
  }
  .code :global(.s) {
    color: #99ffe4;
  }
  .code :global(.f) {
    color: #ffc799;
  }
  .code :global(.c) {
    color: #585858;
  }

  /* The copy buttons sit on the dark card in both themes. */
  .body :global(sesame-copy-button) {
    --sl-color-gray-4: #6e6a65;
    --sl-color-gray-6: rgb(255 255 255 / 0.08);
    --sl-color-white: #f2f0ec;
    --sl-color-accent: #ffaa3b;
  }

  .link {
    display: inline-flex;
    align-self: flex-start;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-family: var(--sl-font);
    font-size: 0.9375rem;
    font-weight: 500;
    color: #f2f0ec;
    text-decoration: none;
  }

  .link span {
    color: #ffaa3b;
    transition: transform 200ms var(--sesame-ease-out);
  }

  @media (hover: hover) {
    .link:hover span {
      transform: translateX(3px);
    }
  }

  @media (max-width: 56rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }

    .art {
      min-height: 13rem;
      -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent);
      mask-image: linear-gradient(180deg, #000 70%, transparent);
    }

    .body {
      padding: 0.5rem 0.75rem 1.5rem 1.25rem;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link span {
      transition: none;
    }
  }
</style>
