---
/**
 * Prototype "Command": the page ends on a single action. Centred title, one
 * large install command to copy, the migration as a quiet follow-up, then the
 * two buttons from the hero.
 */
import CopyButton from '../../components/CopyButton.astro'
import { title, guide, install, migrate } from './data'
---

<section class="command">
  <h2>{title}</h2>
  <p class="lead">Install Sésame, run the migrations, register the routes. The guide walks you through the rest.</p>

  <div class="bar">
    <span class="p" aria-hidden="true">$</span>
    <code>{install}</code>
    <CopyButton text={install} label={`Copy ${install}`} />
  </div>

  <div class="then">
    <span>then</span>
    <code>{migrate}</code>
    <CopyButton text={migrate} label={`Copy ${migrate}`} />
  </div>

  <div class="actions">
    <a class="button primary" href={guide}>Read the setup guide</a>
    <a class="button ghost" href="https://github.com/Julien-R44/sesame">GitHub</a>
  </div>
</section>

<style>
  .command {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 2rem 1rem;
    text-align: center;
  }

  h2 {
    max-width: 40rem;
    margin: 0;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .lead {
    max-width: 30rem;
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    text-wrap: balance;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    max-width: 30rem;
    height: 3.5rem;
    margin-top: 2.5rem;
    padding: 0 0.5rem 0 1.25rem;
    border: 1px solid var(--sesame-border-strong);
    border-radius: 0.75rem;
    background: var(--sesame-surface);
    font-family: var(--sl-font-mono);
    font-size: 0.9375rem;
  }

  .p {
    color: var(--sl-color-accent);
    user-select: none;
  }

  .bar code,
  .then code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    white-space: nowrap;
  }

  .bar code {
    color: var(--sl-color-white);
  }

  .bar :global(sesame-copy-button) {
    margin-inline-start: auto;
  }

  .then {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.875rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  .then span {
    font-family: var(--sl-font);
    color: var(--sl-color-gray-4);
  }

  .then :global(sesame-copy-button) {
    margin-inline-start: -0.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 2.625rem;
    padding-inline: 1.125rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      transform 150ms var(--sesame-ease-out);
  }

  .button:active {
    transform: scale(0.97);
  }

  .primary {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .ghost {
    border: 1px solid var(--sesame-border-strong);
    color: var(--sl-color-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      background: var(--sl-color-gray-1);
    }

    .ghost:hover {
      background: var(--sl-color-gray-6);
    }
  }

  @media (max-width: 36rem) {
    .bar {
      height: 3rem;
      padding-left: 1rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
