---
/**
 * The capabilities as cards. Each one has a small illustration from the
 * hero's world, drawn with the same ASCII renderer.
 */
import type { ImageMetadata } from 'astro'
import Ascii from './Ascii.astro'
import { cards } from './capabilities'
import pkce from '../assets/features/pkce.jpg'
import rotation from '../assets/features/rotation.jpg'
import oidc from '../assets/features/oidc.jpg'
import stores from '../assets/features/stores.jpg'
import mcp from '../assets/features/mcp.jpg'
import hashed from '../assets/features/hashed.jpg'

const art: Record<string, ImageMetadata> = { pkce, rotation, oidc, stores, mcp, hashed }
---

<ul class="features not-content">
  {
    cards.map((card) => (
      <li>
        <a href={card.href}>
          <span class="art" aria-hidden="true">
            <Ascii
              src={art[card.id]}
              size={7}
              mobileSize={6.5}
              focus={0.5}
              place={0.5}
              y={0.5}
              zoom={1}
              white={0.32}
              gamma={0.45}
              threshold={0.03}
            />
          </span>
          <span class="body">
            <span class="tag">{card.tag}</span>
            <span class="title">{card.title}</span>
            <span class="text">{card.text}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    margin: 0;
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--sesame-border);
    border-radius: 0.75rem;
    background: #0a0a0a;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 150ms ease-out;
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* The illustration stays dark in both themes, like the hero. */
  .art {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: #050505;
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent);
    mask-image: linear-gradient(180deg, #000 70%, transparent);
  }

  /* Breathing room: the drawing never touches the card edges. */
  .art :global(sesame-ascii) {
    inset: var(--art-pad-y, 1.75rem) var(--art-pad-x, 2.5rem) 1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: -1.5rem;
    padding: 0 1.25rem 1.375rem;
  }

  .tag {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: #ffaa3b;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #f2f0ec;
  }

  .text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #a19d97;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      border-color: rgb(255 255 255 / 0.2);
    }
  }

  @media (max-width: 56rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
