<a href={siteTitleHref} class="site-title">
  <svg class="wordmark" viewBox="4 4 1251 275" aria-hidden="true" focusable="false">
    <path d={path} fill="currentColor" fill-rule="evenodd" />
  </svg>
  <span class="sr-only" translate="no">{siteTitle}</span>
  <span class="badge" aria-hidden="true">docs</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.25rem 0.375rem;
    margin-inline: -0.375rem;
    border-radius: var(--sesame-radius-sm);
    text-decoration: none;
    color: var(--sl-color-white);
  }

  .wordmark {
    --h: 1.5rem;
    display: block;
    flex-shrink: 0;
    height: var(--h);
    width: calc(var(--h) * 1251 / 275);
  }

  .badge {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 0.3125rem 0.4375rem 0.25rem;
    border-radius: var(--sesame-radius-xs);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--sl-color-accent) 30%, transparent);
    translate: 0 1px;
  }

  @media (max-width: 30rem) {
    .badge {
      display: none;
    }
  }
</style>
