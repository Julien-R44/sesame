---
/**
 * Replaces Starlight's header with a calmer bar: wordmark and section links
 * on the left, search and GitHub on the right.
 */
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import SocialIcons from 'virtual:starlight/components/SocialIcons'

const { hasSidebar, id } = Astro.locals.starlightRoute

const links = [
  { label: 'Guides', href: '/guides/getting-started/', section: 'guides/' },
  { label: 'Migrations', href: '/migrations/0-7-to-0-8/', section: 'migrations/' },
  { label: 'Reference', href: '/reference/configuration/', section: 'reference/' },
]
---

<div class="bar" data-has-sidebar={hasSidebar ? '' : undefined}>
  <div class="start">
    <SiteTitle />
    <nav class="links" aria-label="Sections">
      {
        links.map((link) => (
          <a href={link.href} aria-current={id.startsWith(link.section) ? 'true' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="end print:hidden">
    <Search />
    <div class="prefs">
      <span class="divider" aria-hidden="true"></span>
      <div class="social">
        <SocialIcons />
      </div>
    </div>
  </div>
</div>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  /* Without a sidebar, the bar lines up with the page content below it. */
  .bar:not([data-has-sidebar]) {
    max-width: var(--sl-content-width);
    margin-inline: auto;
  }

  .start,
  .end,
  .prefs,
  .social {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .start {
    gap: 2rem;
    height: 100%;
  }

  .end {
    gap: 0.5rem;
  }

  .prefs {
    gap: 0.125rem;
  }

  /* Docs pages on mobile: preferences live in the menu, next to the sidebar. */
  [data-has-sidebar] .prefs {
    display: none;
  }

  .divider {
    width: 1px;
    height: 1rem;
    margin-inline: 0.5rem 0.25rem;
    background: var(--sesame-border);
  }

  .links {
    display: none;
    align-items: stretch;
    gap: 1.5rem;
    height: 100%;
  }

  .links a {
    position: relative;
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 450;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .links a:hover,
  .links a[aria-current='true'] {
    color: var(--sl-color-white);
  }

  /* The current section sits on the header's bottom edge. */
  .links a[aria-current='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: calc(-1 * var(--sl-nav-pad-y) - 1px);
    height: 1px;
    background: var(--sl-color-accent);
  }

  .social :global(a) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    padding: 0;
    color: var(--sl-color-gray-3);
    transition: color 160ms ease;
  }

  .social :global(a:hover) {
    color: var(--sl-color-white);
  }

  .social :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 50rem) {
    [data-has-sidebar] .prefs {
      display: flex;
    }
  }

  @media (min-width: 64rem) {
    .links {
      display: flex;
    }
  }
</style>
