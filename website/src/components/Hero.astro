---
/**
 * Homepage hero: the door drawn as ASCII, the copy centred over it. The art
 * fades out on the sides and the bottom. The hero stays dark in both themes:
 * it is a photo at night.
 */
import CopyButton from './CopyButton.astro'
import Ascii from './Ascii.astro'
import heroImage from '../assets/hero-duo-arches.jpg'
import AsciiTweaks from './AsciiTweaks.astro'
import { getImage } from 'astro:assets'

const { data } = Astro.locals.starlightRoute.entry
const hero = data.hero!
const actions = hero.actions ?? []
const command = 'node ace add @julr/sesame'

/* Dev only: candidate hero images for the tweak panel. */
const candidates = import.meta.env.DEV
  ? await Promise.all(
      Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/hero*.jpg', { eager: true })).map(
        async ([path, mod]) => ({
          name: path.replace(/^.*\/(hero-?)?|\.jpg$/g, '') || 'photo',
          src: (await getImage({ src: mod.default, width: 960, format: 'webp', quality: 80 })).src,
        }),
      ),
    )
  : []
---

<section class="hero not-content">
  <div class="art" aria-hidden="true">
    <Ascii src={heroImage} focus={0.5} place={0.5} y={0.5} zoom={1} />
    <div class="shade"></div>
    <div class="spot"></div>
  </div>

  <p class="kicker">OAuth 2.1 and OpenID Connect for AdonisJS</p>
  <h1 id="_top" data-page-title>{hero.title ?? data.title}</h1>
  {hero.tagline && <p class="tagline" set:html={hero.tagline} />}

  <div class="actions">
    {
      actions.map((action) => (
        <a
          href={action.link}
          class:list={['button', action.variant === 'primary' ? 'primary' : 'ghost']}
          {...action.attrs}
        >
          {action.text}
        </a>
      ))
    }
  </div>

  <div class="command">
    <span class="prompt" aria-hidden="true">$</span>
    <code>{command}</code>
    <CopyButton text={command} label="Copy install command" />
  </div>

  {/* Dev only: never rendered in a build. */}
  {import.meta.env.DEV && <AsciiTweaks images={candidates} />}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100vw;
    /* About half the screen; it grows if the copy needs more room. */
    min-height: max(28rem, var(--hero-height, 50svh));
    margin-inline: calc(50% - 50vw);
    /* Slide under the fixed header and the content panel padding. */
    margin-top: calc(-1 * (var(--sl-nav-height) + 1.5rem));
    padding: calc(var(--sl-nav-height) + 2rem) 1.5rem 2rem;
    /* Dark in both themes; in light, the last stretch blends into the page. */
    background: linear-gradient(180deg, #0a0a0a calc(100% - 6rem), var(--sl-color-black));
    color: #f2f0ec;
    text-align: center;
  }

  /* ------------------------------------------------------------- art -- */

  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    --fade-x: var(--hero-fade-x, 12%);
    --fade-bottom: var(--hero-fade-bottom, 27%);
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(180deg, #000 calc(100% - var(--fade-bottom)), transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(180deg, #000 calc(100% - var(--fade-bottom)), transparent);
    mask-composite: intersect;
  }

  .shade,
  .spot {
    position: absolute;
    inset: 0;
  }

  .shade {
    background: linear-gradient(180deg, rgb(10 10 10 / 0) 55%, rgb(10 10 10 / 0.7) 85%, #0a0a0a 100%);
  }

  /* A dark pool behind the copy, so it reads over the brightest glyphs. */
  .spot {
    background: radial-gradient(ellipse 20% 17% at 50% 52%, rgb(5 5 5 / 0.96) 35%, rgb(5 5 5 / 0) 100%);
  }

  /* ------------------------------------------------------------ copy -- */

  .kicker {
    margin: 0 0 1.25rem;
    font-size: 0.875rem;
    color: #8a8681;
  }

  h1 {
    margin: 0;
    font-family: var(--sl-font);
    font-size: clamp(3.25rem, 2rem + 5vw, 5.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: #f2f0ec;
  }

  .tagline {
    max-width: 32rem;
    margin: 1.5rem 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: #a19d97;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin: 2.25rem 0 1.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    height: 2.625rem;
    padding-inline: 1.125rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      transform 150ms var(--sesame-ease-out);
  }

  .button:active {
    transform: scale(0.97);
  }

  .primary {
    background: #f2f0ec;
    color: #0a0a0a;
  }

  .ghost {
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #f2f0ec;
  }

  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      background: #fff;
    }

    .ghost:hover {
      border-color: rgb(255 255 255 / 0.3);
      background: rgb(255 255 255 / 0.04);
    }
  }

  .command {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: #a19d97;
  }

  .prompt {
    color: #6e6a65;
    user-select: none;
  }

  .command code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    white-space: nowrap;
  }

  /* The copy button sits on the dark hero in both themes. */
  .command :global(sesame-copy-button) {
    --sl-color-gray-4: #6e6a65;
    --sl-color-gray-6: rgb(255 255 255 / 0.08);
    --sl-color-white: #f2f0ec;
    --sl-color-accent: #ffaa3b;
    margin-inline-start: -0.25rem;
  }

  @media (max-width: 40rem) {
    /* The copy covers most of the width: widen the dark pool behind it. */
    .spot {
      background: radial-gradient(ellipse 75% 30% at 50% 55%, rgb(5 5 5 / 0.92) 45%, rgb(5 5 5 / 0) 100%);
    }

    .tagline {
      font-size: 1rem;
    }
  }
</style>
