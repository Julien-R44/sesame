---
/**
 * The homepage sections under the hero: the authorization code flow, the
 * capabilities and the quick start.
 */
import CopyButton from './CopyButton.astro'
import Features from './Features.astro'
import Flow from './Flow.astro'

const flowSection = {
  title: 'The authorization code flow, in four steps',
  lead: 'An authorization code flow with PKCE, refresh token rotation, introspection and revocation, out of the box.',
}

const capabilitiesSection = {
  title: 'Everything an authorization server needs',
  lead: 'Built on the OAuth 2.1 specification, with the guard, scopes and token tooling you expect from an AdonisJS package.',
}

const quickStartSection = {
  title: 'Two commands to open the door',
  lead: 'Install Sésame, run the migrations and register your OAuth routes.',
  guide: '/guides/getting-started/',
}

const commands = [
  {
    command: 'node ace add @julr/sesame',
    note: 'config/sesame.ts, migrations, provider, scope middleware',
  },
  {
    command: 'node ace migration:run',
    note: 'clients, codes, tokens, grants, pending requests',
  },
]

const routes = `import router from '@adonisjs/core/services/router'
import sesame from '@julr/sesame/services/main'

router.group(() => {
  sesame.registerRoutes()
}).prefix('/oauth')

sesame.registerDiscoveryRoutes()`

const routesHtml = `<span class="k">import</span> router <span class="k">from</span> <span class="s">'@adonisjs/core/services/router'</span>
<span class="k">import</span> sesame <span class="k">from</span> <span class="s">'@julr/sesame/services/main'</span>

router.<span class="f">group</span>(() =&gt; {
  sesame.<span class="f">registerRoutes</span>()     <span class="c">// /oauth/authorize, /oauth/token…</span>
}).<span class="f">prefix</span>(<span class="s">'/oauth'</span>)

sesame.<span class="f">registerDiscoveryRoutes</span>()  <span class="c">// /.well-known/*, JWKS</span>`

---

<div class="sections not-content">
  <section class="section">
    <header class="head">
      <h2>{flowSection.title}</h2>
      <p class="lead">{flowSection.lead}</p>
    </header>

    <Flow />
  </section>

  <section class="section">
    <header class="head">
      <h2>{capabilitiesSection.title}</h2>
      <p class="lead">{capabilitiesSection.lead}</p>
    </header>

    <Features />
  </section>

  <section class="section qs">
    <header class="head">
      <h2>{quickStartSection.title}</h2>
      <p class="lead">{quickStartSection.lead}</p>
      <a class="link" href={quickStartSection.guide}>
        Read the setup guide <span aria-hidden="true">→</span>
      </a>
    </header>

    <sesame-quick-start class="win">
      <div class="tabs" role="tablist" aria-label="Quick start">
        <button type="button" role="tab" id="qs-tab-term" aria-controls="qs-term" aria-selected="true">
          Terminal
        </button>
        <button type="button" role="tab" id="qs-tab-routes" aria-controls="qs-routes" aria-selected="false" tabindex="-1">
          start/routes.ts
        </button>
      </div>

      <div class="panels">
        <div class="panel term" role="tabpanel" id="qs-term" aria-labelledby="qs-tab-term">
          {
            commands.map((c) => (
              <div class="cmd">
                <span class="p" aria-hidden="true">$</span>
                <code>{c.command}</code>
                <CopyButton text={c.command} label={`Copy ${c.command}`} />
                <span class="note">{c.note}</span>
              </div>
            ))
          }
        </div>

        <div class="panel file" role="tabpanel" id="qs-routes" aria-labelledby="qs-tab-routes" hidden>
          <pre class="code"><code set:html={routesHtml} /></pre>
          <CopyButton class="copy" text={routes} label="Copy start/routes.ts" />
        </div>
      </div>
    </sesame-quick-start>
  </section>
</div>

<script>
  /** Tabs for the quick start window: click, or arrow keys between tabs. */
  class SesameQuickStart extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab
          t.setAttribute('aria-selected', String(on))
          t.tabIndex = on ? 0 : -1
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on
        }
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab))
        tab.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
          const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length]
          select(next)
          next.focus()
        })
      })
    }
  }

  if (!customElements.get('sesame-quick-start')) customElements.define('sesame-quick-start', SesameQuickStart)
</script>

<style>
  .sections {
    padding-bottom: 6rem;
  }

  .section {
    padding-top: clamp(5rem, 10vw, 8rem);
  }

  .section:first-child {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .head {
    max-width: 38rem;
    margin-bottom: 3.5rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .lead {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------- Quick start */

  .qs {
    display: grid;
    grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
    column-gap: 4rem;
    align-items: center;
  }

  .qs .head {
    margin-bottom: 0;
  }

  .link {
    display: inline-flex;
    gap: 0.375rem;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .link span {
    color: var(--sl-color-accent);
    transition: transform 200ms var(--sesame-ease-out);
  }

  @media (hover: hover) {
    .link:hover span {
      transform: translateX(3px);
    }
  }

  /* Like the code frames in the docs, dark in both themes. */
  .win {
    display: block;
    min-width: 0;
    border: 1px solid #252524;
    border-radius: 0.75rem;
    background: #0d0d0d;
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #d6d3ce;
  }

  .tabs {
    display: flex;
    border-bottom: 1px solid #252524;
    background: #121212;
  }

  [role='tab'] {
    position: relative;
    height: 2.5rem;
    padding: 0 1.25rem;
    border: 0;
    border-right: 1px solid #252524;
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    color: #6e6a65;
    cursor: pointer;
    transition: color 150ms ease-out;
  }

  [role='tab'][aria-selected='true'] {
    margin-bottom: -1px;
    border-bottom: 1px solid #0d0d0d;
    background: #0d0d0d;
    color: #f2f0ec;
  }

  [role='tab'][aria-selected='true']::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: #ffaa3b;
  }

  @media (hover: hover) {
    [role='tab']:hover {
      color: #f2f0ec;
    }
  }

  [role='tab']:focus-visible {
    outline: 2px solid #ffaa3b;
    outline-offset: -2px;
  }

  /* Both panels share one cell: the window keeps the taller one's height. */
  .panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .panel[hidden] {
    display: block;
    visibility: hidden;
  }

  .term {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 1.25rem 0.75rem 1.25rem 1.25rem;
  }

  .cmd {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    align-items: center;
  }

  .p {
    color: #ffaa3b;
    user-select: none;
  }

  .cmd code,
  .code code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .cmd code {
    color: #f2f0ec;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .note {
    grid-column: 2 / -1;
    margin-top: -0.25rem;
    font-size: 0.75rem;
    color: #6e6a65;
  }

  .file {
    position: relative;
  }

  .code {
    margin: 0;
    padding: 1.25rem 3rem 1.25rem 1.25rem;
    overflow-x: auto;
    border: 0;
    background: none;
    color: #d6d3ce;
  }

  .file :global(.copy) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }

  /* Vesper, like the code blocks in the docs. */
  .code :global(.k) {
    color: #a0a0a0;
  }
  .code :global(.s) {
    color: #99ffe4;
  }
  .code :global(.f) {
    color: #ffc799;
  }
  .code :global(.c) {
    color: #585858;
  }

  /* The copy buttons sit on the dark window in both themes. */
  .win :global(sesame-copy-button) {
    --sl-color-gray-4: #6e6a65;
    --sl-color-gray-6: rgb(255 255 255 / 0.08);
    --sl-color-white: #f2f0ec;
    --sl-color-accent: #ffaa3b;
  }

  /* ------------------------------------------------------------ Responsive */

  @media (max-width: 64rem) {
    .qs {
      column-gap: 2.5rem;
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .head {
      margin-bottom: 2.5rem;
    }

    .qs {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
    }

    .win {
      font-size: 0.75rem;
    }

    .term,
    .code {
      padding-left: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link span,
    [role='tab'] {
      transition: none;
    }
  }
</style>
