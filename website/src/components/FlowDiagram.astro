---
/**
 * The authorization code flow, as described in the README, drawn as a track.
 */
const steps = [
  {
    label: 'Authorize',
    endpoint: 'GET /oauth/authorize',
    text: 'The app redirects the user with its client_id, redirect_uri, scope, state and an S256 code_challenge.',
  },
  {
    label: 'Consent',
    endpoint: 'consentPage',
    text: 'The user logs in and approves the scopes. Already approved scopes skip consent.',
  },
  {
    label: 'Exchange',
    endpoint: 'POST /oauth/token',
    text: 'The code and the PKCE code_verifier are exchanged for an access_token and refresh_token.',
  },
  {
    label: 'Call',
    endpoint: 'Authorization: Bearer',
    text: 'The app passes the access token as a Bearer token when calling your API.',
  },
]
---

<ol class="flow not-content">
  {
    steps.map((step, index) => (
      <li class="step" style={`--i: ${index}`}>
        <div class="marker" aria-hidden="true">
          <span>{String(index + 1).padStart(2, '0')}</span>
        </div>
        <p class="label">{step.label}</p>
        <code class="endpoint">{step.endpoint}</code>
        <p class="text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    --rail: 2.25rem;
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail the requests travel on. */
  .flow::before {
    content: '';
    position: absolute;
    inset-block: 1rem;
    inset-inline-start: calc(var(--rail) / 2 - 1px);
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      var(--sl-color-accent),
      color-mix(in oklab, var(--sl-color-accent) 15%, var(--sesame-border))
    );
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.375rem;
    align-items: start;
  }

  .marker {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: var(--rail);
    height: var(--rail);
    border-radius: var(--sesame-radius-sm);
    border: 1px solid color-mix(in oklab, var(--sl-color-accent) 40%, var(--sesame-border));
    background: var(--sl-color-black);
    box-shadow:
      0 0 0 4px var(--sl-color-black),
      0 0 18px -4px rgb(var(--sesame-glow) / 0.5);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-accent-high);
  }

  .label {
    margin: 0.375rem 0 0;
    font-family: var(--sesame-font-display);
    font-size: 1.125rem;
    font-weight: 620;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }

  .endpoint {
    justify-self: start;
    padding: 0.1875rem 0.5rem;
    border-radius: var(--sesame-radius-xs);
    border: 1px solid var(--sesame-border);
    background: var(--sesame-surface);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-1);
  }

  .text {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  @media (min-width: 50rem) {
    .flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .flow::before {
      inset-block: auto;
      top: calc(var(--rail) / 2 - 1px);
      inset-inline: calc(var(--rail) / 2) 12.5%;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--sl-color-accent),
        color-mix(in oklab, var(--sl-color-accent) 15%, var(--sesame-border))
      );
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
    }

    .marker {
      grid-row: auto;
      margin-bottom: 0.75rem;
    }

    .label {
      margin-top: 0;
    }
  }

  /* Only the copy fades in. The markers stay opaque over the track. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step :is(.label, .endpoint, .text) {
        animation: light-up linear both;
        animation-timeline: view();
        animation-range: entry calc(10% + var(--i) * 12%) cover calc(30% + var(--i) * 12%);
      }
    }
  }

  @keyframes light-up {
    from {
      opacity: 0.35;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
